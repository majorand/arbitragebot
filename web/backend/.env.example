# =============================================================================
# ArbitrageBot Configuration Template
# Copy this file to backend.env and fill in your actual credentials
# =============================================================================

# -----------------------------------------------------------------------------
# Database - Supabase (PostgreSQL)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# -----------------------------------------------------------------------------
# Data Providers
# -----------------------------------------------------------------------------

# Kalshi
KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_API_SECRET=your_kalshi_api_secret_here
KALSHI_API=https://api.kalshi.com

# Polymarket
POLYMARKET_PRIVATE_KEY=0x_your_ethereum_private_key_here

# -----------------------------------------------------------------------------
# Trading Configuration
# -----------------------------------------------------------------------------
TRADING_MODE=paper
MIN_EDGE_PCT=2.0
MAX_STAKE=100.0
MAX_EXPOSURE_PER_MARKET=500.0
DAILY_LOSS_LIMIT=1000.0
BANKROLL=10000.0

# Risk Limits
MAX_STAKE_PER_LEG=100.0
MAX_EXPOSURE_PER_EVENT=500.0
MAX_EXPOSURE_PER_PROVIDER=2000.0
MAX_TOTAL_EXPOSURE=5000.0
MAX_LOSS_PER_TRADE=500.0

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
FRONTEND_ORIGINS=http://localhost:3000
REFRESH_INTERVAL=30
LOG_LEVEL=INFO
DEBUG=False
