# Local development: point the frontend to your locally running backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# NOTE (Vercel): Your `vercel.json` references a Vercel Secret named
# `next_public_api_base_url` via:
#   "NEXT_PUBLIC_API_BASE_URL": "@next_public_api_base_url"
#
# Fixes (pick one):
# 1) Create the secret in Vercel (recommended):
#    vercel login
#    vercel secrets add next_public_api_base_url "https://api.yourdomain.com"
#    (then re-deploy or push to trigger Vercel)
#
# 2) Add the variable directly in the Vercel Project > Settings > Environment Variables
#    (set NAME=NEXT_PUBLIC_API_BASE_URL, VALUE=https://api.yourdomain.com)
#
# 3) For quick testing only: replace the @-secret reference in vercel.json
#    with a literal URL (not recommended for real secrets).

